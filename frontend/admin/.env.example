# CampusBite Admin Portal Environment Variables
# For Render Deployment, set this in Environment Variables tab

# URL to your deployed Render backend (including /api/v1)
VITE_API_URL=https://your-backend-service.onrender.com/api/v1

# Optional: Link to deployed student app
VITE_STUDENT_URL=https://your-student-app.onrender.com
