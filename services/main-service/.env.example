# Application
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# MongoDB
MONGODB_URI=mongodb://campusbite_admin:change_me@localhost:27017/campusbite?authSource=admin

# Redis
REDIS_URL=redis://:redis_change_me@localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=campusbite-api
KAFKA_GROUP_ID_PREFIX=campusbite

# JWT
JWT_ACCESS_SECRET=generate_with_openssl_rand_base64_64
JWT_REFRESH_SECRET=generate_another_with_openssl_rand_base64_64
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Razorpay (TEST/SANDBOX only)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Email
EMAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.gmail@gmail.com
SMTP_PASSWORD=your_gmail_app_password_16_chars
EMAIL_FROM=CampusBite <noreply@campusbite.dev>
EMAIL_FROM_NAME=CampusBite
